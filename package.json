{
    "name": "endeavour-cli",
    "version": "0.1.0",
    "description": "Script the Endeavour public docs API without hand-built integrations.",
    "homepage": "https://github.com/krakeflow/endeavour-cli#readme",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/krakeflow/endeavour-cli.git"
    },
    "bin": {
        "endeavour": "./bin/endeavour.cjs"
    },
    "files": [
        "bin",
        "dist/endeavour.js",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "scripts": {
        "build": "bun run script/build.ts",
        "build:js": "tsc -p tsconfig.json && chmod +x dist/endeavour.js",
        "build:single": "bun run script/build.ts --single",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "smoke": "bun ./bin/endeavour.ts docs list",
        "lint": "bun lint --no-script",
        "fmt": "bun fmt --no-script",
        "fmt:check": "bun fmt --check --no-script",
        "compile:aot": "bun build --compile --aot --trim --outfile dist/endeavour ./bin/endeavour.ts",
        "prepublishOnly": "bun run build:js"
    },
    "dependencies": {
        "@effect/platform-node": "4.1.0",
        "effect": "4.1.0"
    },
    "devDependencies": {
        "@types/bun": "1.3.9",
        "typescript": "5.9.2"
    },
    "engines": {
        "node": ">=26"
    }
}
