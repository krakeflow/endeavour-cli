{
    "printWidth": 120,
    "tabWidth": 4,
    "semi": false,
    "sortPackageJson": {
        "sortScripts": true
    },
    "overrides": [
        {
            "files": ["*.json", "*.jsonc"],
            "options": {
                "tabWidth": 4,
                "trailingComma": "none"
            }
        },
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["*.md"],
            "options": {
                "printWidth": 100,
                "tabWidth": 2,
                "proseWrap": "always"
            }
        }
    ],
    "ignorePatterns": ["bun.lock", "dist/"]
}
